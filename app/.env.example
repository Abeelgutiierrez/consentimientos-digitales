# Copia este archivo como .env.local para desarrollo (npm run setup:env lo hace por ti
# y genera claves aleatorias). NUNCA subas .env.local a Git.

# --- Base de datos (docker compose up) ---
# Rol de la aplicación: sin superusuario, sujeto a Row-Level Security.
DATABASE_URL=postgres://consent_app:consent_app_dev@localhost:5433/consentimientos
# Rol propietario: solo para migraciones y datos de demostración.
DATABASE_OWNER_URL=postgres://consent_owner:consent_owner_dev@localhost:5433/consentimientos
# Base de datos de los tests (la crea docker/initdb).
TEST_DATABASE_URL=postgres://consent_app:consent_app_dev@localhost:5433/consentimientos_test
TEST_DATABASE_OWNER_URL=postgres://consent_owner:consent_owner_dev@localhost:5433/consentimientos_test

# --- Cifrado de datos sensibles (salud, firmas, DNI, PDFs) ---
# Anillo de claves AES-256 "id:base64" separadas por comas. La activa cifra; las demás solo descifran.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡Si pierdes la clave pierdes los datos! Guárdala fuera de las copias de seguridad de la base de datos.
DATA_ENCRYPTION_KEYS=k1:CAMBIA_ESTO_POR_32_BYTES_EN_BASE64
DATA_ENCRYPTION_ACTIVE_KEY=k1
# Clave HMAC para el índice ciego del DNI (buscar sin descifrar). 32 bytes en base64.
BLIND_INDEX_KEY=CAMBIA_ESTO_POR_32_BYTES_EN_BASE64

# --- Aplicación ---
# Dirección pública que se codifica en el QR (sin barra final). Vacío = IP de la Wi-Fi.
# PUBLIC_URL=https://consentimientos.ejemplo.com
# Nivel de log: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Correo (opcional) ---
# Sin estas dos variables los correos se simulan y se guardan en «Correos enviados».
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Estudio <hola@tudominio.com>

# --- Tareas programadas (cumpleaños, limpieza de sesiones) ---
# 1 = el propio servidor las ejecuta al arrancar y cada hora. Si no, programa `npm run jobs` con cron.
# JOBS_IN_PROCESS=1
