# Copia este archivo como .env si quieres cambiar algo. Todo es opcional.

# Puerto del servidor (por defecto 3000)
PORT=3000

# Dirección pública que se codifica en el QR. Si la dejas vacía se usa la IP de tu Wi-Fi.
# Útil si expones la demo con un túnel (ngrok, Cloudflare Tunnel...).
# PUBLIC_URL=https://mi-demo.ejemplo.com

# Envío real de correos con Resend (https://resend.com). Sin esto, los correos se simulan.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Estudio Demo <hola@tudominio.com>
